---
interface Props {
  site: { title: string };
  logo?: {
    alt: string;
    href: string;
    svg?: string;
    text?: string;
  } | null;
  locale?: string;
}

const { site, logo } = Astro.props;
const href = logo?.href ?? "/";
const title = logo?.text?.trim() ? logo.text : site.title;
---

<a class="flex min-w-0 items-center gap-3 sm:gap-4" href={href}>
  {
    logo?.svg && (
      <span
        aria-hidden="true"
        class="inline-flex size-12 shrink-0 items-center justify-center rounded-2xl bg-[#fff6e4] shadow-sm ring-1 ring-black/10 sm:size-16 dark:ring-white/15 [&>svg]:h-9 [&>svg]:w-auto sm:[&>svg]:h-12"
        set:html={logo.svg}
      />
    )
  }
  <span class="flex min-w-0 flex-col">
    <span class="truncate font-display text-lg font-semibold tracking-tight text-foreground sm:text-2xl">
      {title}
    </span>
    <span class="mt-0.5 hidden truncate text-sm text-muted-foreground sm:block">
      One shared connection for your machine
    </span>
  </span>
</a>
