---
import data from "blume:data";

interface Props {
  headings: { depth: number; slug: string; text: string }[];
  page: { description?: string; route: string; title: string };
  route: string;
}

const { page, route } = Astro.props;
const home = route === "/" || page.route === "/";
const description = page.description ?? data.config.description;
---

{
  home && description && (
    <section
      aria-labelledby="home-banner-title"
      class="home-banner relative -mx-6 -mt-6 mb-14 overflow-hidden px-6 py-16 sm:py-24 lg:-mx-8 xl:-mx-10"
    >
      <div class="mx-auto flex max-w-3xl flex-col items-center text-center">
        <img
          alt=""
          class="size-24 rounded-[1.75rem] bg-[#fff6e4] p-3.5 shadow-lg sm:size-28"
          height="112"
          src="/favicon.svg"
          width="112"
        />
        <h1
          class="mt-8 font-display text-4xl font-semibold tracking-tight text-white sm:text-6xl"
          id="home-banner-title"
        >
          {data.config.title}
        </h1>
        <p class="mt-5 max-w-xl text-lg text-white/90 sm:text-xl">{description}</p>
        <a
          class="mt-8 inline-flex items-center rounded-full bg-white px-5 py-2.5 font-medium text-[#01497c] transition-opacity hover:opacity-90"
          href="/install/"
        >
          Install
        </a>
      </div>
    </section>
  )
}

<style>
  .home-banner {
    background-color: #01579b;
    background-image:
      radial-gradient(42rem 18rem at 50% -6rem, rgb(255 255 255 / 0.2), transparent 70%),
      linear-gradient(180deg, #0288d1 0%, #01579b 100%);
  }

  /* The home page's own title is the banner. The layout still prints the
     page heading and lede under it. */
  :global(main:has(.home-banner) > article > h1:first-of-type),
  :global(main:has(.home-banner) > article > h1:first-of-type + p) {
    display: none;
  }
</style>
