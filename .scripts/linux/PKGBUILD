#!/bin/sh
# Maintainer: Aidan Timson (Timmo) <aidan@timmo.dev>
pkgname=ha-bridge-git
pkgver=20261001.0.r1.g0000000
pkgrel=1
pkgdesc="One shared Home Assistant connection for your machine, served to local apps over a single socket (git version)"
arch=('x86_64' 'aarch64')
url="https://github.com/timmo001/ha-bridge"
license=('Apache-2.0')
keywords=('home-assistant' 'automation' 'cli' 'websocket')
makedepends=('git' 'bun')
depends=('glibc')
provides=('ha-bridge')
conflicts=('ha-bridge' 'ha-bridge-bin')
options=('!strip')
source=("$pkgname::git+https://github.com/timmo001/ha-bridge.git")
md5sums=('SKIP')

pkgver() {
  cd "$pkgname"
  git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  cd "$pkgname"
  bun install --frozen-lockfile
  bun run build
  ./dist/ha-bridge --completions zsh >ha-bridge.zsh
  ./dist/ha-bridge --completions bash >ha-bridge.bash
  ./dist/ha-bridge --completions fish >ha-bridge.fish
}

package() {
  cd "$srcdir/$pkgname"
  install -Dm755 dist/ha-bridge "$pkgdir/usr/bin/ha-bridge"
  install -Dm644 ha-bridge.zsh "$pkgdir/usr/share/zsh/site-functions/_ha-bridge"
  install -Dm644 ha-bridge.bash "$pkgdir/usr/share/bash-completion/completions/ha-bridge"
  install -Dm644 ha-bridge.fish "$pkgdir/usr/share/fish/vendor_completions.d/ha-bridge.fish"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
