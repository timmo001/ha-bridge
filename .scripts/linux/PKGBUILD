#!/bin/sh
# Maintainer: Aidan Timson (Timmo) <aidan@timmo.dev>
pkgname=ha-bridge-git
pkgver=0.1.0.r1.abc123
pkgrel=1
pkgdesc="One shared Home Assistant connection for your machine, served to local apps over a single socket (git version)"
arch=('x86_64' 'aarch64')
url="https://github.com/timmo001/ha-bridge"
license=('Apache-2.0')
install=ha-bridge.install
makedepends=('git' 'bun')
depends=('glibc')
provides=('ha-bridge')
conflicts=('ha-bridge' 'ha-bridge-bin')
options=('!strip')
source=("$pkgname::git+https://github.com/timmo001/ha-bridge.git")
md5sums=('SKIP')

pkgver() {
  cd "$pkgname"
  local base_version
  base_version=$(bun -e 'const pkg = await Bun.file("package.json").json(); process.stdout.write(pkg.version)')
  printf "%s.r%s.g%s" "$base_version" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  cd "$pkgname"
  bun install --frozen-lockfile
  bun run build
  local shell
  for shell in zsh bash fish; do
    ./dist/ha-bridge --completions "$shell" >"ha-bridge.$shell"
  done
}

package() {
  cd "$srcdir/$pkgname"
  install -Dm755 dist/ha-bridge "$pkgdir/usr/bin/ha-bridge"
  install -Dm644 .scripts/linux/ha-bridge.service "$pkgdir/usr/lib/systemd/user/ha-bridge.service"
  install -Dm644 ha-bridge.zsh "$pkgdir/usr/share/zsh/site-functions/_ha-bridge"
  install -Dm644 ha-bridge.bash "$pkgdir/usr/share/bash-completion/completions/ha-bridge"
  install -Dm644 ha-bridge.fish "$pkgdir/usr/share/fish/vendor_completions.d/ha-bridge.fish"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
