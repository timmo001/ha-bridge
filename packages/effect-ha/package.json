{
  "name": "@timmo001/effect-ha",
  "version": "1.1.0",
  "description": "Effect services, schemas and typed actions for Home Assistant",
  "keywords": [
    "effect",
    "home-assistant",
    "websocket"
  ],
  "homepage": "https://github.com/timmo001/ha-bridge/tree/main/packages/effect-ha#readme",
  "bugs": {
    "url": "https://github.com/timmo001/ha-bridge/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timmo001/ha-bridge.git",
    "directory": "packages/effect-ha"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "!src/**/*.test.ts"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "effect": "4.0.2"
  },
  "devDependencies": {
    "effect": "4.0.2"
  }
}
